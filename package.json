{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:redirect": "wrangler deploy --config redirect/wrangler.toml",
    "deploy:all": "npm run deploy && npm run deploy:redirect"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "vite": "latest",
    "wrangler": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260625.1": true,
    "sharp@0.34.5": true
  }
}
